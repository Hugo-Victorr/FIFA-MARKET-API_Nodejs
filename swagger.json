    "/vendaitem/adiciona": {
  "post": {
    "summary": "Adicionar um item à venda",
    "tags": ["VendaItem"],
    "security": [{ "bearerAuth": [] }],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": ["venda_id", "produto", "quantidade", "valor"],
            "properties": {
              "venda_id": { "type": "string", "example": "60e8fbd90c2e4c001c8a7b3b" },
              "produto": { "type": "string", "example": "Camisa" },
              "quantidade": { "type": "integer", "example": 2 },
              "valor": { "type": "number", "example": 79.90 }
            }
          }
        }
      }
    },
    "responses": {
      "201": { "description": "Item adicionado com sucesso" },
      "400": { "description": "Erro na criação" }
    }
  }
    },
