    "security": [{ "bearerAuth": [] }],
    "responses": {
      "200": { "description": "Posições removidas com sucesso" },
      "500": { "description": "Erro ao limpar posições" }
    }
  }
    },
    "/venda/adiciona": {
  "post": {
    "summary": "Registrar uma nova venda",
    "tags": ["Venda"],
    "security": [{ "bearerAuth": [] }],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "descricao": { "type": "string", "example": "Venda camisa oficial" },
              "valor": { "type": "number", "example": 99.90 },
              "data": { "type": "string", "format": "date", "example": "2025-07-03" }
            }
          }
        }
      }
    },
    "responses": {
      "201": { "description": "Venda criada com sucesso" },
      "400": { "description": "Erro na requisição" }
    }
  }
    },
