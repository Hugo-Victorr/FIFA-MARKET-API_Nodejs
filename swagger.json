    },
    "/posicao/atualiza/{id}": {
  "put": {
    "summary": "Atualizar uma posição existente",
    "tags": ["Posição"],
    "security": [{ "bearerAuth": [] }],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "ID da posição a ser atualizada"
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "nome": { "type": "string", "example": "Atacante" }
            }
          }
        }
      }
    },
    "responses": {
      "200": { "description": "Posição atualizada com sucesso" },
      "400": { "description": "ID ausente ou dados inválidos" },
      "404": { "description": "Posição não encontrada" }
    }
  }
    },
    "/posicao/delete/{id}": {
  "delete": {
    "summary": "Excluir uma posição por ID",
    "tags": ["Posição"],
    "security": [{ "bearerAuth": [] }],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "ID da posição"
      }
    ],
    "responses": {
      "200": { "description": "Posição removida com sucesso" },
      "400": { "description": "ID inválido" },
      "404": { "description": "Posição não encontrada" },
      "500": { "description": "Erro no servidor" }
    }
  }
    },
    "/posicao/deleteAll": {
  "delete": {
    "summary": "Deletar todas as posições (não implementado)",
    "tags": ["Posição"],
    "security": [{ "bearerAuth": [] }],
    "responses": {
      "501": { "description": "Rota não implementada" }
    }
  }
    },
    "/posicao/clear": {
  "post": {
    "summary": "Limpar todas as posições do usuário autenticado",
